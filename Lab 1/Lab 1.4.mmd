classDiagram
    direction TB

    class User {
        +String userID
        +String name
        +String email
        +login()
        +logout()
    }

    class Staff {
        +String staffID
        +String role
        +addBook()
        +manageMember()
    }

    class Member {
        +String memberID
        +String membershipType
        +requestBook()
        +reserveBook()
    }

    class Book {
        +String isbn
        +String title
        +String author
        +Boolean isAvailable
        +checkAvailability()
    }

    class Reservation {
        +String reservationID
        +Date requestDate
        +String status
        +cancelReservation()
    }

    class Loan {
        +String loanID
        +Date issueDate
        +Date dueDate
        +calculateFine()
    }

    User <|-- Staff
    User <|-- Member

    Member "1" --> "*" Reservation : requests
    Book "1" --> "*" Reservation : tagged_in

    Member "1" --> "*" Loan : borrows
    Book "1" --> "*" Loan : linked_to