erDiagram
    MEMBER ||--o{ LOAN : "creates"
    BOOK ||--o{ LOAN : "referenced_in"
    MEMBER ||--o{ RESERVATION : "creates"
    BOOK ||--o{ RESERVATION : "associated_with"

    MEMBER {
        string member_id PK
        string membership_type
    }

    BOOK {
        string isbn PK
        string title
        string author
        boolean is_available
    }

    LOAN {
        string loan_id PK
        string member_id FK
        string isbn FK
        date issue_date
        date due_date
    }

    RESERVATION {
        string reservation_id PK
        string member_id FK
        string isbn FK
        date request_date
        string status
    }